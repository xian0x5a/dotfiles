# Session-wide environment for Niri.
# Imported by the niri.service drop-in before `niri --session`, so niri,
# niri-spawned apps, user services, and D-Bus activation share these static vars.

# ELECTRON_OZONE_PLATFORM_HINT=auto
# QT_QPA_PLATFORM=wayland
# QT_QPA_PLATFORMTHEME=kde
# QT_QPA_PLATFORMTHEME=xdgdesktopportal
# QT_QPA_PLATFORMTHEME=qt6ct
QT_QPA_PLATFORMTHEME=gtk3
# Disable DrKonqi in the Niri session. KDE tools honor KDE_DEBUG and skip
# launching the crash reporter, which avoids the observed DrKonqi crash loop.
# KDE_DEBUG=1
# Point KDE menu lookups at /etc/xdg/menus/plasma-applications.menu so KDE
# components do not fall back to the missing plain applications.menu file.
# required for dolphin to find default application to open a file?
# XDG_MENU_PREFIX=plasma-
QS_ICON_THEME=Papirus-Dark

# GTK_IM_MODULE is left unset on purpose, following fcitx5 advice for Wayland
# sessions to unset GTK_IM_MODULE; https://fcitx-im.org/wiki/Using_Fcitx_5_on_Wayland).
#
# a value naming the wayland module (for example `GTK_IM_MODULE=wayland:fcitx`) makes GTK3 apps running on X11 SIGSEGV as soon as they take focus, because GTK3 loads im-wayland.so there too and it runs against a NULL wl_display. 
# `GTK_IM_MODULE=fcitx` will lead to an inconsistent theme and tone color issue
#GTK_IM_MODULE=wayland:fcitx
QT_IM_MODULE=fcitx
QT_IM_MODULES='wayland;fcitx;ibus'
XMODIFIERS='@im=fcitx'
SDL_IM_MODULE=fcitx

# NVIDIA 615.x keeps ~16 bytes of host memory per GL submission in its
# per-context GPU busy-time collector and frees none of it before eglTerminate.
# niri leaked ~110 MB/day over the 12 days before this went in.
# `__GL_4718a5` is the driver's own switch for that collector (default on, not
# documented by NVIDIA). Turning it off flattens the leak in every tested path
# (plain flush, glFenceSync/glDeleteSync, EGL native fence): 100k submissions
# grew 1.4 MB with it on and 0 with it off. Its only consumer found in the
# binary is the nvidia.powerd D-Bus client, which is inactive here.
# Drop this once NVIDIA ships a fix; if a driver update ignores the name, the
# leak simply comes back, so re-check after major driver bumps.
# https://forums.developer.nvidia.com/t/615-78-08-glfencesync-leaks-host-memory-never-freed/385726
__GL_4718a5=0
