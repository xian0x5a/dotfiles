{
  "cleanupPeriodDays": 365,
  "env": {
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "CLAUDE_CODE_SIMPLE_SYSTEM_PROMPT": "1"
  },
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "allow": [],
    "deny": [
      "EnterPlanMode",
      "Artifact",
      "ArtifactComments",
      "ArtifactData",
      "Workflow"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '~/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "node \"$HOME/.claude/statusline.js\"",
    "refreshInterval": 60
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "node \"$HOME/.claude/subagent-statusline.js\""
  },
  "feedbackDrafts": "off",
  "alwaysThinkingEnabled": true,
  "autoCompactWindow": 300000,
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "editorMode": "vim",
  "switchModelsOnFlag": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skillOverrides": {
    "artifact-design": "off",
    "artifact-capabilities": "off",
    "artifact-diagramming": "off",
    "workflow-authoring": "off",
    "anthropic-skills:artifact-emulator": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:chrome-browser": "off",
    "anthropic-skills:skill-creator": "off"
  }
}
